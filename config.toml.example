# herdr-jira-board configuration
#
# Copy this file to one of (checked in this order):
#   1. `herdr plugin config-dir jira-board`  (usually ~/.config/herdr/plugins/config/jira-board/config.toml)
#   2. ~/.config/herdr-jira-board/config.toml

# Your Jira Cloud site URL.
site = "https://your-site.atlassian.net"

# The email address of your Atlassian account.
email = "you@example.com"

# API token created at https://id.atlassian.com/manage-profile/security/api-tokens
# (choose the classic "Create API token", not "with scopes").
api_token = ""

# Alternatively, run a command to fetch the token (stdout is used).
# Safer than storing the token in this file.
# api_token_cmd = "security find-generic-password -s jira-api-token -w"

# Optional: JQL for the issues shown on the board.
# Default: your open issues plus issues completed in the last 7 days.
# jql = "assignee = currentUser() AND (statusCategory != Done OR updated >= -7d) ORDER BY updated DESC"

# Optional: status names to hide from the board, compared case-insensitively.
# Handy for a custom workflow status that never reaches the Done category and
# would otherwise sit in the In Progress column forever. Applied on top of `jql`,
# so you keep the default query instead of rewriting it.
# exclude_statuses = ["Resolved"]

# Optional: order of the status groups inside a column, compared
# case-insensitively. A column that mixes several statuses (typically
# In Progress) shows a divider per status; listed statuses come first in this
# order, the rest follow in JQL result order.
# status_order = ["In Review", "In Progress"]

# Optional: labels `l` can put on a card and take off again, for a stage that
# does not deserve a workflow status of its own. Cards carrying one sort to the
# top of their status group, in the order declared here, and show `display`.
# Namespace the label: Jira labels are shared with every project on the site.
# [[phase_labels]]
# label = "jb_verifying"
# display = "verifying"

# Optional: the board's priority ladder. Rules are evaluated top-down and the
# first match gives the card its rank: it shows a marker (`display`, or P1/P2/…
# by position) and sorts to the top of its status group, ahead of the phase
# labels. `epic` is the parent epic — its key, or a piece of its name; omit it
# to match any epic. `priority` is the Jira priority name; omit it to match any
# ("regardless of priority"). Cards matching no rule keep their usual place.
# [[board_priority]]
# epic = "ST test"
# priority = "Blocker"
#
# [[board_priority]]
# epic = "ST test"            # any remaining ST issue, whatever its priority
#
# [[board_priority]]
# epic = "UAT test"
# priority = "Severe"

# Optional: label changes to make when a transition run from the board lands
# on a status (compared case-insensitively). `add` puts labels on; `remove`
# takes the listed ones off; `remove_except` — exclusive with `remove` —
# takes off every label this file mentions other than the listed ones.
# Labels other people put on an issue are never touched, and a rule never
# removes a label it adds. Only transitions run from the board trigger rules;
# a status changed in the Jira web UI does not (that is what Jira's own
# automation is for).
# [[status_labels]]
# status = "In Review"
# add = ["jb_verifying"]
#
# [[status_labels]]
# status = "Done"
# remove_except = ["jb_verifying"]

# Optional: UI language, "en" or "ja". Omit to follow the system locale
# (LC_ALL / LC_MESSAGES / LANG).
# language = "en"

# Optional: whether the focused card's session preview (its last Claude reply)
# starts on. `p` turns it off and on again while the board runs; this only sets
# what it starts as. Default: true.
# preview = false

# Optional: working directory for Claude sessions, per Jira project key.
# Defaults to your home directory when not set.
[project_dirs]
# PROJ = "~/repos/proj"
